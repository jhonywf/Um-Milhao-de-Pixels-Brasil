+
+/* V7 — mobile-first wall compacting and individual pixel coloring */
+.wall-main { padding-top: clamp(28px, 4vw, 54px); }
+.wall-heading { align-items: center; margin-bottom: 28px; }
+.wall-heading h1 { font-size: clamp(42px, 5.8vw, 78px); line-height: .88; }
+.wall-intro { max-width: 290px; }
+.wall-intro p { margin-bottom: 11px; font-size: 15px; }
+.canvas-hint { max-width: calc(100% - 32px); flex-wrap: wrap; }
+.customizer-actions { display: grid; gap: 8px; }
+.customizer-secondary { width: 100%; min-height: 43px; border: 1px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; font: 700 10px var(--app-font-mono); text-transform: uppercase; }
+.recolor-banner { position: absolute; z-index: 13; left: 18px; right: 18px; bottom: 88px; min-height: 42px; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 10px; border: 1px solid var(--sun); background: var(--ink); color: var(--sun); font: 700 9px var(--app-font-mono); text-transform: uppercase; }
+.recolor-banner span { display: inline-flex; align-items: center; gap: 7px; }.recolor-banner button { min-height: 28px; padding: 0 10px; border: 0; background: var(--sun); color: var(--ink); cursor: pointer; font: 700 9px var(--app-font-mono); text-transform: uppercase; }
+.selection-summary { padding: 22px 20px; }
+.selection-summary-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 16px; font: 700 10px var(--app-font-mono); text-transform: uppercase; }
+.selection-summary-title strong { color: var(--mint); font-size: 10px; }
+.selection-summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; border: 1px solid rgba(36,32,59,.16); background: rgba(36,32,59,.16); }
+.selection-summary-grid > div { min-width: 0; padding: 13px 12px; background: var(--paper); }
+.selection-summary-grid span { display: block; margin-bottom: 7px; color: rgba(36,32,59,.52); font: 8px var(--app-font-mono); text-transform: uppercase; }
+.selection-summary-grid b { display: block; overflow-wrap: anywhere; font: 600 10px var(--app-font-mono); }
+.selection-summary .selection-button { margin-top: 14px; }
+.compact-selection { padding: 24px 20px; }
+.compact-empty { padding: 22px 20px; }
+.compact-empty .empty-cross { width: 50px; height: 50px; margin-bottom: 14px; }.compact-empty h2 { margin-bottom: 8px; font-size: 25px; }.compact-empty p { font-size: 12px; }
+
+@media (max-width: 620px) {
+  .wall-main { padding: 18px 14px 32px; }
+  .wall-heading { display: grid; gap: 8px; margin-bottom: 14px; }
+  .wall-heading > div:first-child { display: grid; gap: 7px; }
+  .wall-heading .eyebrow { font-size: 8px; }
+  .wall-heading h1 { margin: 0; font-size: clamp(29px, 8.4vw, 39px); line-height: .9; letter-spacing: -.075em; }
