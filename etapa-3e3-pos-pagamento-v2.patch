+  useEffect(() => {
+    const params = new URLSearchParams(window.location.search);
+    const payment = params.get('payment');
+    if (!payment) return;
+
+    let snapshot: PendingPaymentSnapshot | null = null;
+    try {
+      const raw = window.localStorage.getItem(PENDING_PAYMENT_STORAGE_KEY);
+      snapshot = raw ? JSON.parse(raw) as PendingPaymentSnapshot : null;
+    } catch {
+      snapshot = null;
+    }
+
+    setPaymentSnapshot(snapshot);
+
+    if (payment === 'failure') {
+      setPaymentReturnState('failure');
+      return;
+    }
+
+    if (payment === 'pending') {
+      setPaymentReturnState('pending');
+      return;
+    }
+
+    if (payment !== 'success') return;
+    setPaymentReturnState('checking');
+
+    let cancelled = false;
+    let attempts = 0;
+
+    const verify = async () => {
+      attempts += 1;
+      try {
+        const pixels = await loadPublicWallPixels();
+        const purchased = new Set(
+          pixels
+            .filter((pixel) => pixel.status === 'purchased')
+            .map((pixel) => `${pixel.x}:${pixel.y}`),
+        );
+        const confirmed = !!snapshot?.pixelKeys.length
+          && snapshot.pixelKeys.every((key) => purchased.has(key));
+
+        if (confirmed && !cancelled) {
+          setPaymentReturnState('confirmed');
+          window.localStorage.removeItem(PENDING_PAYMENT_STORAGE_KEY);
+          void refreshPublicPixels();
+          return;
+        }
+      } catch {
+        // A confirmação continua sendo feita pelo webhook no servidor.
+      }
+
+      if (!cancelled && attempts < 15) window.setTimeout(verify, 2000);
+      else if (!cancelled) setPaymentReturnState('pending');
+    };
+
+    void verify();
+    return () => { cancelled = true; };
+  }, [refreshPublicPixels]);
