+
+/* V9 — beige wall route, first-pixel guidance and pinch-safe touch editing */
+.wall-page {
+  background: var(--paper);
+  color: var(--ink);
+}
+.wall-page .site-header {
+  background: var(--paper);
+  color: var(--ink);
+  border-color: rgba(36,32,59,.18);
+}
+.wall-page .brand-lockup { color: var(--ink); }
+.wall-page .desktop-nav a { color: rgba(36,32,59,.68); }
+.wall-page .desktop-nav a:hover,
+.wall-page .desktop-nav a.active { color: var(--coral); }
+.wall-page .header-cta {
+  border-color: var(--ink);
+  box-shadow: 4px 4px 0 var(--ink);
+}
+.wall-main { padding-top: clamp(14px, 2vw, 28px); }
+.canvas-card {
+  border-color: rgba(36,32,59,.24);
+  background: var(--paper);
+}
+.canvas-stage { background: var(--paper); }
+.wall-bottom-note { color: rgba(36,32,59,.58); }
+
+.first-pixel-hint {
+  display: none;
+  position: absolute;
+  z-index: 7;
+  left: 50%;
+  top: 10px;
+  transform: translateX(-50%);
+  max-width: calc(100% - 88px);
+  padding: 7px 10px;
+  border: 1px solid rgba(36,32,59,.18);
+  border-radius: 999px;
+  background: rgba(255,244,201,.94);
+  color: var(--ink);
+  box-shadow: 0 5px 16px rgba(36,32,59,.10);
+  font: 700 8px/1.2 var(--app-font-mono);
+  text-align: center;
+  text-transform: uppercase;
+  pointer-events: none;
+  white-space: nowrap;
+}
+
+@media (max-width: 620px) {
+  .wall-main { padding-top: 10px; }
+  .first-pixel-hint { display: block; }
+}
